{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::__IMAGES_BUCKET__", "arn:aws:s3:::__CVS_BUCKET__"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::__IMAGES_BUCKET__/*",
        "arn:aws:s3:::__CVS_BUCKET__/*"
      ]
    }
  ]
}
