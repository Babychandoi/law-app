# ================= FRONTEND — PROD BUILD (npm run build) =================
# CRA tự ưu tiên file này khi NODE_ENV=production (luc `npm run build` trong Docker).
# Đây là nguồn sự thật cho URL nhúng vào bundle prod — KHÔNG phụ thuộc Docker build args.
REACT_APP_API_URL=https://api.luatpoip.com
REACT_APP_WS_URL=wss://api.luatpoip.com/ws/notifications
REACT_APP_CHAT_WS_URL=https://api.luatpoip.com/ws
REACT_APP_GATEWAY_URL=https://gateway.luatpoip.com
REACT_APP_STAFF_WS_URL=https://gateway.luatpoip.com/ws-staff

# ================= AUTH COOKIES (httpOnly) =================
AUTH_COOKIE_DOMAIN=.luatpoip.com
AUTH_COOKIE_SECURE=true

# ================= SECURITY: khong sinh source map public (lo code goc) =================
# GA/gtag KHONG can source map; chi error-tracking (Sentry...) moi can va nen upload rieng tu.
GENERATE_SOURCEMAP=false
