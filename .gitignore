!.env.example
# .env in any subdirectory (crm-service, chat-service, gateway, ...)
**/.env

# Cloudflare Tunnel secrets / binary
cloudflared/credentials.json
cloudflared.exe

# SSL certificates & private keys (KHONG commit private key)
certbot/conf/live/
