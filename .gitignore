certbot/conf/keys/
# ACME account key + metadata (private key cua tai khoan Let's Encrypt)
certbot/conf/accounts/

# Build output (Maven / Java) — build ra, khong commit
**/target/
# Backup dump DB/MinIO — chua du lieu ca nhan that (CV ung vien, SDT, email khach).
# TUYET DOI khong commit.
backups/

# Ho so tam cua Chrome khi chup san trang (frontend/scripts/prerender.js)
frontend/.prerender-profile/
