SPRING_APPLICATION_NAME=law-app-backend

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/law_app?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
SPRING_DATASOURCE_USERNAME=lawapp
SPRING_DATASOURCE_PASSWORD=lawapp123
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect
SPRING_JPA_GENERATE_DDL=true
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_HIBERNATE_DDL_AUTO=create-drop
SPRING_JPA_HIBERNATE_NAMING_PHYSICAL_STRATEGY=org.hibernate.boot.model.naming.CamelCaseToUnderscoresNamingStrategy
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect
SPRING_JPA_PROPERTIES_HIBERNATE_GLOBALLY_QUOTED_IDENTIFIERS=true
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

MYSQL_ROOT_PASSWORD=12345678
MYSQL_DATABASE=law_app
MYSQL_USER=lawapp
MYSQL_PASSWORD=lawapp123

SPRING_DATA_MONGODB_HOST=localhost
SPRING_DATA_MONGODB_PORT=27017
SPRING_DATA_MONGODB_DATABASE=law-app-chat
MONGO_ROOT_PASSWORD=12345678

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=20MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=25MB

EMAIL_USERNAME=
EMAIL_PASSWORD=

JWT_SIGNER_KEY=change-this-secret-key
JWT_VALID_DURATION=3600
# Refresh token = phiên đăng nhập. 604800 = 7 ngày. Refresh JWT exp + Redis TTL đều theo giá trị này.
JWT_REFRESHABLE_DURATION=604800

MINIO_URL=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Production: unique randomly generated service credentials. Root credentials are only for MinIO
# bootstrap/administration and must not be injected into application containers.
MINIO_BACKEND_ACCESS_KEY=lawapp-backend
MINIO_BACKEND_SECRET_KEY=replace-with-random-backend-secret
MINIO_CHAT_ACCESS_KEY=lawapp-chat
MINIO_CHAT_SECRET_KEY=replace-with-random-chat-secret
MINIO_DOCUMENT_ACCESS_KEY=lawapp-documents
MINIO_DOCUMENT_SECRET_KEY=replace-with-random-document-secret
MINIO_BUCKET_IMAGES=images
MINIO_BUCKET_CVS=cvs
MINIO_BUCKET_STAFF_FILES=staff-files
MINIO_BUCKET_DOCUMENT_TEMPLATES=document-templates
MINIO_BUCKET_GENERATED_DOCUMENTS=generated-documents

# ================= AI CHATBOT (9Router, OpenAI-compatible) =================
AI_CHAT_PROVIDER_NAME=9Router
# Point at any OpenAI-compatible endpoint; "/v1" is auto-suffixed with "/chat/completions".
AI_CHAT_API_URL=http://host.docker.internal:20128/v1
AI_CHAT_API_KEY=
AI_CHAT_API_KEY_REQUIRED=true
AI_CHAT_MODEL=AI-PRO
AI_CHAT_TEMPERATURE=0.7
AI_CHAT_MAX_TOKENS=8192
CHATBOT_ENABLED=false

LOGGING_LEVEL_ORG_HIBERNATE_SQL=INFO
LOGGING_LEVEL_ORG_HIBERNATE_TYPE_DESCRIPTOR_SQL=INFO

REACT_APP_API_URL=http://localhost:8080
REACT_APP_WS_URL=http://localhost:8080/ws
REACT_APP_CHAT_WS_URL=http://localhost:8080/ws
# Gateway (staff-chat microservice). Prod: https://gateway.luatpoip.com and wss://gateway.luatpoip.com/ws-staff
REACT_APP_GATEWAY_URL=http://localhost:8081
REACT_APP_STAFF_WS_URL=http://localhost:8081/ws-staff

# ==================== CHAT SERVICE (internal staff chat microservice) ====================
CHAT_SERVICE_PORT=8082
# Isolated MongoDB database on the shared Mongo instance.
CHAT_MONGODB_HOST=law-app-mongodb
CHAT_MONGODB_PORT=27017
CHAT_MONGODB_DATABASE=law-app-staff-chat
CHAT_MAX_FILE_SIZE=25MB
CHAT_MAX_REQUEST_SIZE=30MB
CHAT_CORS_ORIGINS=http://localhost:3000,https://luatpoip.com,https://www.luatpoip.com
# How chat-service reaches the monolith for the staff directory (/auth/users).
MONOLITH_INTERNAL_URL=http://law-app-backend:8080

# ==================== API GATEWAY ====================
GATEWAY_PORT=8081
GATEWAY_CORS_ORIGINS=http://localhost:3000,https://luatpoip.com,https://www.luatpoip.com
MONOLITH_URI=http://law-app-backend:8080
MONOLITH_WS_URI=ws://law-app-backend:8080
CHAT_SERVICE_URI=http://law-app-chat:8082
CHAT_SERVICE_WS_URI=ws://law-app-chat:8082
DOCUMENT_SERVICE_URI=http://document-service:8084

# ==================== DOCUMENT SERVICE (Word template generation) ====================
DOCUMENT_SERVICE_PORT=8084
DOCUMENT_MONGODB_HOST=law-app-mongodb
DOCUMENT_MONGODB_PORT=27017
DOCUMENT_MONGODB_DATABASE=law-app-documents
DOCUMENT_MAX_FILE_SIZE=25MB
DOCUMENT_MAX_REQUEST_SIZE=30MB
# 32 random bytes, Base64 encoded. Example generation:
#   openssl rand -base64 32
# Required for new legal-document generation; do not reuse JWT or MinIO secrets.
DOCUMENT_DATA_ENCRYPTION_KEY=
DOCUMENT_DATA_ENCRYPTION_KEY_ID=primary-2026-07
# Optional comma-separated keyId:base64 entries retained only while old records still use them.
DOCUMENT_DATA_ENCRYPTION_PREVIOUS_KEYS=
# Production Compose enables fail-closed ClamAV scanning before a template is persisted.
DOCUMENT_ANTIVIRUS_ENABLED=true
DOCUMENT_ANTIVIRUS_FAIL_CLOSED=true
DOCUMENT_ANTIVIRUS_HOST=clamav
DOCUMENT_ANTIVIRUS_PORT=3310

# ==================== RABBITMQ (STOMP broker relay) ====================
RABBITMQ_USER=lawapp
RABBITMQ_PASS=lawapp123
RABBITMQ_STOMP_HOST=law-app-rabbitmq
RABBITMQ_STOMP_PORT=61613

# ==================== CRM SERVICE (customer-care microservice) ====================
CRM_SERVICE_PORT=8083
CRM_DATASOURCE_URL=jdbc:mysql://law-app-mysql:3306/law_app_crm?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
CRM_DATASOURCE_USERNAME=lawapp
CRM_DATASOURCE_PASSWORD=lawapp123
CRM_JPA_DDL_AUTO=update
# 32 random bytes, Base64 encoded. Keep this separate from JWT, MinIO, and document keys.
# Missing or invalid configuration makes matter-party PII endpoints fail closed with HTTP 503.
CRM_DATA_ENCRYPTION_KEY=
CRM_DATA_ENCRYPTION_KEY_ID=primary-2026-07
# Optional comma-separated keyId:base64 entries retained during key rotation.
CRM_DATA_ENCRYPTION_PREVIOUS_KEYS=
CRM_SERVICE_URI=http://law-app-crm:8083

# ==================== RABBITMQ AMQP (CRM event bus: monolith publishes, crm consumes) ====================
RABBITMQ_AMQP_HOST=law-app-rabbitmq
RABBITMQ_AMQP_PORT=5672

# ==================== AUTH COOKIES (httpOnly auth + CSRF double-submit) ====================
# Shared across *.luatpoip.com. NO leading dot (RFC 6265; servlet Cookie rejects ".x.com").
# Leave empty for local http dev (host-only cookie) and set AUTH_COOKIE_SECURE=false.
AUTH_COOKIE_DOMAIN=luatpoip.com
AUTH_COOKIE_SECURE=true

ADMIN_NOTIFICATION_EMAIL=

# ================= ADMIN BOOTSTRAP (one-time) =================
# Set both to create the first admin account on startup, then REMOVE them.
# Leave empty to skip bootstrap (normal state once the account exists).
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Document module: bật gửi email (link chia sẻ) — dùng lại EMAIL_USERNAME/EMAIL_PASSWORD
DOCUMENT_MAIL_ENABLED=false
# URL công khai để chèn link chia sẻ vào email (mặc định gateway prod)
DOCUMENT_SHARE_PUBLIC_BASE_URL=https://gateway.luatpoip.com
